# ---------------------------------------------------------------------------
# Variáveis para rodar a stack com `docker compose` (uso LOCAL).
# Copie para `.env.docker` e preencha. NUNCA versione o `.env.docker` preenchido.
# Em produção (Railway) defina estas variáveis no painel do projeto, não aqui.
# ---------------------------------------------------------------------------

# Chave secreta do Django. Gere uma nova, longa e aleatória — nunca reutilize.
# Ex.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Mantenha False fora de desenvolvimento (True expõe stack traces e settings).
DEBUG=False

# Hosts permitidos, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para CSRF, COM esquema, separadas por vírgula.
# Em produção, inclua o domínio público (ex.: https://seu-app.up.railway.app).
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Servir sobre HTTP no docker local exige desligar o redirect para HTTPS.
# Em produção (TLS terminado no Railway) deixe True ou remova esta variável.
SECURE_SSL_REDIRECT=False

# --- PostgreSQL (serviço `db` do docker-compose) ---
POSTGRES_DB=emy
POSTGRES_USER=emy
# Senha forte e única. Ex.: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# String de conexão usada pelo Django. O host `db` é o nome do serviço no compose.
# Mantenha usuário/senha/banco IGUAIS aos POSTGRES_* acima.
DATABASE_URL=postgres://emy:CHANGE_ME@db:5432/emy
