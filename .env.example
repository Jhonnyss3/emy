SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=

# Optional. Without it, the app uses the local SQLite file. Set to a PostgreSQL
# URL to use Postgres instead (Docker/Railway set this automatically).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# CSRF trusted origins (with scheme), comma-separated. Needed in production for
# forms over HTTPS, e.g. https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Production only (ignored while DEBUG=True). HSTS max-age in seconds; start
# with a small value when rolling out, then raise. Default: 31536000 (1 year).
SECURE_HSTS_SECONDS=31536000

# Production only. Set to False if TLS is terminated upstream or to serve over
# plain HTTP locally in a container. Defaults to True.
# SECURE_SSL_REDIRECT=True
